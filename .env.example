# FactoryOS Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual secrets.
# NEVER commit .env with real credentials into source control.

# Active Spring Profile (e.g., dev, demo, prod)
SPRING_PROFILES_ACTIVE=dev

# Server Port
SERVER_PORT=8080

# PostgreSQL Datasource Configuration
DB_URL=jdbc:postgresql://localhost:5432/factoryos
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here

# Hibernate DDL Strategy (update for dev, validate for prod)
JPA_DDL_AUTO=update

# CORS Allowed Origins (comma-separated list of allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Swagger / OpenAPI Availability (true for dev, false for prod)
SWAGGER_ENABLED=true
